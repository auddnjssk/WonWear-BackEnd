<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <properties>
        <!-- 필요한 경우 속성을 정의하세요 -->
    </properties>

    <!-- MyBatis 설정 -->
    <settings>
        <!-- 전통적인 데이터베이스 컬럼명 형태인 A_COLUMN을 CamelCase형태의 자바 프로퍼티명 형태인 aColumn으로 자동으로 매핑하도록 함 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 파라미터에 Null 값이 있을 경우 에러 처리 -->
        <setting name="jdbcTypeForNull" value="VARCHAR"/>
    </settings>

    <!-- Type Aliases 설정 -->
    <typeAliases>
        <!-- <typeAlias alias="YourType" type="com.example.YourTypeClass"/> -->
    </typeAliases>

    <typeHandlers>
        <!-- 사용자 정의 타입 핸들러 정의 -->
    </typeHandlers>

    <objectFactory type="org.apache.ibatis.reflection.DefaultObjectFactory"/>

    <!-- 환경 설정 -->
    <environments default="development"> <!-- 'default' 속성 추가 -->
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <!-- MySQL 드라이버 클래스의 변경으로 인해 명시 -->
                <property name="driver" value="org.postgresql.Driver"/>
                <property name="url" value="jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=disable"/>
                <property name="username" value="postgres.ircbxvnsnfbbmkhjukzn"/>
                <property name="password" value="723546zxcv!"/>
            </dataSource>
        </environment>
    </environments>
    <mappers>
        <mapper resource="mapper/ItemMapper.xml"/>
        <mapper resource="mapper/loginMapper.xml"/>
    </mappers>
</configuration>
